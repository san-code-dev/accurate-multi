# ============ Data (tenant & audit) ============
# Daftar tenant (token & secret Accurate) dan catatan audit. Folder data/ JANGAN di-commit.
# Tenant dikelola lewat halaman admin; contoh format ada di tenants.example.json.
TENANTS_FILE=data/tenants.json
AUDIT_FILE=data/audit.log

# ============ Katalog endpoint ============
ACCURATE_SPEC_URL=https://account.accurate.id/open-api/json.do
# Opsional: salinan lokal spesifikasi bila server tidak bisa mengunduhnya.
ACCURATE_SPEC_FILE=

# ============ MCP (npm start / Docker) ============
PORT=3031
HOST=127.0.0.1
# Token pelindung endpoint /mcp (wajib di mode HTTP). Buat acak, mis: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ============ Halaman admin ============
# Port terpisah, bawaan hanya untuk komputer server (127.0.0.1). Di Docker dipetakan ke 127.0.0.1:3032.
ADMIN_PORT=3032
ADMIN_HOST=127.0.0.1
# Wajib, minimal 12 karakter. Tanpa ini halaman admin tidak dijalankan.
ADMIN_PASSWORD=
