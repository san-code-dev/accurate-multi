# ============ Daftar tenant (database Accurate) ============
# Kredensial tiap database Accurate disimpan di file JSON ini (lihat config/tenants.example.json).
# File dibaca ulang otomatis saat diubah; tidak perlu restart. JANGAN di-commit.
TENANTS_FILE=config/tenants.json

# ============ Katalog endpoint baca ============
ACCURATE_SPEC_URL=https://account.accurate.id/open-api/json.do
# Opsional: salinan lokal spesifikasi bila server tidak bisa mengunduhnya.
ACCURATE_SPEC_FILE=

# ============ Mode HTTP (npm start / Docker) ============
PORT=3031
HOST=127.0.0.1
# Token pelindung endpoint /mcp (wajib di mode HTTP). Buat acak, mis: openssl rand -hex 32
MCP_AUTH_TOKEN=
